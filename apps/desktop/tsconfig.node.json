{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "incremental": true,
    "tsBuildInfoFile": "./node_modules/.cache/tsc/node.tsbuildinfo",
    "module": "preserve",
    "moduleResolution": "bundler",
    "lib": ["es2024"],
    "types": ["node", "electron-vite/node"]
  },
  "include": [
    "src/main/**/*.ts",
    "src/preload/**/*.ts",
    "src/i18n/**/*.ts",
    "electron.vite.config.ts"
  ],
  "references": [{ "path": "../../packages/kernel" }, { "path": "../../packages/contracts" }]
}
