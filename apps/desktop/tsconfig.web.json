{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "incremental": true,
    "tsBuildInfoFile": "./node_modules/.cache/tsc/web.tsbuildinfo",
    "module": "preserve",
    "moduleResolution": "bundler",
    "lib": ["es2024", "dom", "dom.iterable"],
    "jsx": "react-jsx",
    "types": ["vite/client"],
    "paths": { "@/*": ["./src/renderer/src/*"], "@renderer/*": ["./src/renderer/src/*"] }
  },
  "include": [
    "src/renderer/**/*.ts",
    "src/renderer/**/*.tsx",
    "src/preload/index.d.ts",
    "src/i18n/**/*.ts"
  ],
  "references": [{ "path": "../../packages/kernel" }, { "path": "../../packages/contracts" }]
}
