# Local development settings for the phase-0 chat. Copy to `.env.local` (gitignored) and fill in.
# `pnpm dev` and `pnpm test:live` read `.env.local`; variables already set in your shell win.
# KEY=VALUE, no quotes, no `export`.

# The Anthropic wire to Zhipu (https://open.bigmodel.cn/api/anthropic) is a custom vendor now:
# in the settings card, create an anthropic-messages instance at that address with a
# pay-as-you-go key, then pick it in the model menu. ANTHROPIC_BASE_URL may only name
# https://api.anthropic.com — any other address leaves anthropic not configured — and
# ANTHROPIC_AUTH_TOKEN is no longer for compatible endpoints (its key would be bound to the
# default host, api.anthropic.com). （2026-10-02 改，见 [M6 §点名 (d)](docs/features/custom-vendors/spec.md)）
# ANTHROPIC_API_KEY=
# If ANTHROPIC_API_KEY is set in your shell, the Claude Code on this machine switches to it and
# bills at API rates instead of your subscription. Keep it out of your shell profile.
# （2026-09-25 改，见 [02 §模型与密钥](docs/architecture/02-agent-loop/spec.md)）

# Model you chat with in `pnpm dev`, named as the endpoint names it. Unset = the first row of the builtin table.
# （2026-09-25 改，见 [02 §模型选择](docs/architecture/02-agent-loop/spec.md)）
TENON_MODEL=glm-5.3-flash

# Upper bound on one reply, in tokens. Also your spending cap per message. Unset = 64000.
TENON_MAX_TOKENS=2048

# `pnpm test:live` caps every group's replies with this instead of TENON_MAX_TOKENS.
TENON_LIVE_MAX_TOKENS=1024

# `pnpm test:live`: the builtin zhipu group and both zhipu instance groups use ZHIPU_API_KEY
# (a pay-as-you-go key). Absent = those groups are skipped. （2026-10-02 改，见 [M6 §点名 (d)](docs/features/custom-vendors/spec.md)）
# A GLM Coding Plan key must not be used here or anywhere in Tenon (its subscription agreement,
# clause 6.2); use a pay-as-you-go key. （2026-09-25 改，见 [02 §非目标](docs/architecture/02-agent-loop/spec.md)）
ZHIPU_API_KEY=
# glm-5.3-flashx (~1 s per reply) or glm-4.6 (in the builtin table). Unset = glm-4.6.
# flashx is the speed tier; it costs about 2.5x glm-5.3-flash. （2026-09-25 改，见 [02 §模型与密钥](docs/architecture/02-agent-loop/spec.md)）
# Not glm-4.7-flash: its free tier rate-limits consecutive requests (429 / 1302).
TENON_LIVE_ZHIPU_MODEL=glm-5.3-flashx

# Which provider `pnpm dev` chats through when neither the model menu nor the settings card has
# chosen one: zhipu by default. anthropic goes to the official endpoint only; for a dev chat on the
# Anthropic wire, pick the instance above in the model menu. A choice made in the model menu or
# saved in the settings card always wins over this. （2026-10-02 改，见 [M6 §点名 (d)](docs/features/custom-vendors/spec.md)，Q16）
TENON_PROVIDER=zhipu
