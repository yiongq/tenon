# Local development settings for the phase-0 chat. Copy to `.env.local` (gitignored) and fill in.
# `pnpm dev` and `pnpm test:live` read `.env.local`; variables already set in your shell win.
# KEY=VALUE, no quotes, no `export`.

# Any Anthropic-compatible endpoint. Leave unset for api.anthropic.com.
ANTHROPIC_BASE_URL=https://open.bigmodel.cn/api/anthropic

# The key. Compatible endpoints usually want ANTHROPIC_AUTH_TOKEN (sent as a Bearer token);
# the real Anthropic API wants ANTHROPIC_API_KEY instead. Fill in exactly one.
ANTHROPIC_AUTH_TOKEN=
# ANTHROPIC_API_KEY=

# Model you chat with in `pnpm dev`, named as the endpoint names it. Unset = claude-opus-5.
TENON_MODEL=glm-5.3-flash

# Upper bound on one reply, in tokens. Also your spending cap per message. Unset = 64000.
TENON_MAX_TOKENS=2048

# `pnpm test:live` uses these instead, so you never have to switch. Same key, cheaper model.
TENON_LIVE_MODEL=glm-4.7-flash
TENON_LIVE_MAX_TOKENS=1024
# Optional: a separate key just for the tests (own usage stats, revocable on its own).
# TENON_LIVE_AUTH_TOKEN=
