{
  "name": "@tenon-app/kernel",
  "version": "0.0.0",
  "private": true,
  "description": "Tenon agent kernel: host-independent, talks to the world only through HostAdapter",
  "type": "module",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./testing": {
      "development": "./src/testing/index.ts",
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b tsconfig.test.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.128.0",
    "@mdream/js": "1.7.2",
    "@modelcontextprotocol/client": "2.3.1",
    "@noble/hashes": "2.4.0",
    "openai": "7.23.0",
    "re2js": "2.8.6"
  },
  "devDependencies": {
    "@modelcontextprotocol/node": "2.1.1",
    "@modelcontextprotocol/server": "2.3.1",
    "@modelcontextprotocol/server-everything": "2026.8.31",
    "@types/node": "catalog:",
    "esbuild": "0.28.2",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
